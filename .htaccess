# Apache configuration. Keep private folders and files out of reach of the web.
Options -Indexes
DirectoryIndex index.php

<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteRule ^(data|includes|actions|views)(/|$) - [F,L]
    RewriteRule (^|/)\. - [F,L]
</IfModule>

<FilesMatch "\.(sqlite|sqlite-wal|sqlite-shm|db|md|bat|sh|log)$">
    Require all denied
</FilesMatch>

<FilesMatch "^(setup|router)\.php$">
    Require all denied
</FilesMatch>
